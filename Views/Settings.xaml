<Window x:Class="RetroGamesLauncher.Views.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RetroGamesLauncher.Views"
        xmlns:TopBar="clr-namespace:RetroGamesLauncher.Views.UserControls" 
        xmlns:SettingsTabs="clr-namespace:RetroGamesLauncher.Views.UserControls.SettingsTabs" 
        mc:Ignorable="d"
        Title="Settings" Height="450" Width="800"
        Background="#1e1e1e"
        WindowStyle="None" 
        AllowsTransparency="True" 
        ResizeMode="CanResizeWithGrip">
    <Border Background="#1e1e1e" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Barra personalizada -->
                <RowDefinition Height="*"/>
                <!-- Conteúdo -->
            </Grid.RowDefinitions>
            <!-- BARRA SUPERIOR -->
            <TopBar:CustomTitleBar Grid.Row="0"/>

            <TabControl Grid.Row="1" Margin="10">
                <TabItem Header="Armazenamento"  Style="{StaticResource CustomTabItemStyle}" >
                    <SettingsTabs:SettingsFilesPath/>
                </TabItem>
                <TabItem Header="Jogos"  Style="{StaticResource CustomTabItemStyle}" >
                    <TextBlock>Teste Jogos</TextBlock>
                </TabItem>
                <TabItem Header="Controles"  Style="{StaticResource CustomTabItemStyle}" >
                    <TextBlock>Teste Controles</TextBlock>
                </TabItem>
            </TabControl>

        </Grid>
    </Border>
</Window>
