<Window x:Class="RetroGamesLauncher.Views.Shared.GameGenderForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RetroGamesLauncher.Views.Shared"
        mc:Ignorable="d"
        Title="GameGenderForm" Height="200" Width="450"
        Background="#1e1e1e"
        WindowStyle="None" 
        AllowsTransparency="True" 
        ResizeMode="CanResizeWithGrip"
        xmlns:UserControls="clr-namespace:RetroGamesLauncher.Views.UserControls">
    <Border Background="#1e1e1e" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Barra personalizada -->
                <RowDefinition Height="*"/>
                <!-- Conteúdo -->
            </Grid.RowDefinitions>
        
            <!-- BARRA SUPERIOR -->
            <UserControls:CustomTitleBar Grid.Row="0"/>
            <!-- Conteúdo -->
            <Grid Grid.Row="1" Margin="10">
                <StackPanel>
                    <TextBlock Text="Adicionar Gênero de Jogo" 
                           FontSize="24" 
                           Foreground="White" 
                           Margin="0,0,0,20"/>
                    <TextBox Name="GenderNameTextBox" FontSize="14" AcceptsReturn="True"                         
                         Background="#252526" Foreground="White" BorderBrush="#3c3c3c"/>
                    <TextBlock x:Name="TxtGenderNameFeedBack" FontSize="12" Visibility="Collapsed" Foreground="#ad2f2f"/>
                    <!-- Botões -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Salvar ✔️" Height="30" Width="100" Margin="0,0,10,0" Click="SaveButton_Click"/>
                        <Button Content="Cancelar 🚫" Height="30" Width="100" Click="CancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

