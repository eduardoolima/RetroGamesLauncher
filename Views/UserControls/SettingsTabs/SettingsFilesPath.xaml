<UserControl x:Class="RetroGamesLauncher.Views.UserControls.SettingsTabs.SettingsFilesPath"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RetroGamesLauncher.Views.UserControls.SettingsTabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="📁 Configurações de Armazenamento"
                   FontSize="24"
                   Foreground="White"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="15,0,15,10">
                <!-- Roms -->
                <TextBlock Text="Caminho das ROMs" Margin="0,10,0,0" Foreground="White"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="📁" Width="30" Height="30" Margin="0,0,5,0"
                        Click="BtnChooseRomFolder_Click"
                        ToolTip="Selecionar Pasta"
                        Background="#252526"
                        Foreground="White"
                        BorderBrush="#3c3c3c">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="RomsPathTextBox" Grid.Column="1" Padding="5" FontSize="14" AcceptsReturn="True"
                        Background="#252526" Foreground="White" BorderBrush="#3c3c3c"/>
                </Grid>
                <TextBlock x:Name="TxtRomsFeedBack" FontSize="12" Visibility="Collapsed" Text="" Foreground="#ad2f2f"/>
                <!-- Covers -->
                <TextBlock Text="Caminho das Capas" Margin="0,10,0,0" Foreground="White"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="📁" Width="30" Height="30" Margin="0,0,5,0"
                        Click="BtnChooseCoverFolder_Click"
                        ToolTip="Selecionar Pasta"
                        Background="#252526"
                        Foreground="White"
                        BorderBrush="#3c3c3c">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="CoversPathTextBox" Grid.Column="1" Padding="5" FontSize="14" AcceptsReturn="True"
                        Background="#252526" Foreground="White" BorderBrush="#3c3c3c"/>
                </Grid>
                <TextBlock x:Name="TxtCoversFeedBack" FontSize="12" Visibility="Collapsed" Text="" Foreground="#ad2f2f"/>
                <!-- screenshots -->
                <TextBlock Text="Caminho das Screenshots" Margin="0,10,0,0" Foreground="White"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="📁" Width="30" Height="30" Margin="0,0,5,0"
                        Click="BtnScreenshotsFolder_Click"
                        ToolTip="Selecionar Pasta"
                        Background="#252526"
                        Foreground="White"
                        BorderBrush="#3c3c3c">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBox x:Name="ScreenshotsPathTextBox" Grid.Column="1" Padding="5" FontSize="14" AcceptsReturn="True"
                        Background="#252526" Foreground="White" BorderBrush="#3c3c3c"/>
                </Grid>
                <TextBlock x:Name="TxtScreenshotsFeedBack" FontSize="12" Visibility="Collapsed" Text="" Foreground="#ad2f2f"/>

                <Button Content="Salvar ✔️" Height="30" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Click="SavePathsButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
